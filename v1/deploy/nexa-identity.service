[Unit]
Description=NEXA Identity service (M1)
After=network-online.target
Wants=network-online.target

[Service]
User=admin
WorkingDirectory=/home/admin/Nexa/Nexa
EnvironmentFile=/etc/nexa/identity.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/admin/Nexa/venv310/bin/python -m uvicorn v1.identity.service:app --host 127.0.0.1 --port 8101
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
