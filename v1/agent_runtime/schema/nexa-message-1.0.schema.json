{
  "$defs": {
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "timeout",
            "unavailable",
            "refused",
            "invalid",
            "conflict",
            "budget",
            "cancelled",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "reason": {
          "maxLength": 1000,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "code",
        "retryable",
        "reason"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "OnBehalfOf": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Subject",
          "type": "string"
        },
        "roles": {
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "subject"
      ],
      "title": "OnBehalfOf",
      "type": "object"
    },
    "Party": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "orchestrator",
            "agent",
            "tool",
            "user",
            "service"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 120,
          "minLength": 2,
          "title": "Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Party",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nexa.message/1.0",
      "default": "nexa.message/1.0",
      "title": "Schema",
      "type": "string"
    },
    "message_id": {
      "title": "Message Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "request",
        "result",
        "error",
        "event"
      ],
      "title": "Kind",
      "type": "string"
    },
    "type": {
      "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)+$",
      "title": "Type",
      "type": "string"
    },
    "payload_schema": {
      "title": "Payload Schema",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 80,
      "minLength": 6,
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "in_reply_to": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "In Reply To"
    },
    "trace_id": {
      "maxLength": 80,
      "minLength": 6,
      "title": "Trace Id",
      "type": "string"
    },
    "sender": {
      "$ref": "#/$defs/Party"
    },
    "receiver": {
      "anyOf": [
        {
          "$ref": "#/$defs/Party"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "principal": {
      "anyOf": [
        {
          "$ref": "#/$defs/OnBehalfOf"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "permission": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Permission"
    },
    "created_at": {
      "title": "Created At",
      "type": "number"
    },
    "deadline": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "timeout_s": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout S"
    },
    "attempt": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt"
    },
    "max_attempts": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Attempts"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 8,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency Key"
    },
    "payload": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Payload"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "message_id",
    "kind",
    "type",
    "payload_schema",
    "correlation_id",
    "trace_id",
    "sender",
    "created_at"
