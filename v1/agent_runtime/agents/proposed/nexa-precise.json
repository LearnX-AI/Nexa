{
  "manifest_version": "nexa.agent/1.0",
  "identity": {
    "id": "nexa-precise",
    "name": "NEXA Precise",
    "version": "1.1.0",
    "owner": "NEXA AI engineering (Yasaru)",
    "description": "Low-temperature assistant for factual and mathematical answers, showing the working for every calculation."
  },
  "purpose": {
    "summary": "Give concise, correct factual answers and worked calculations in Mathematics and the sciences.",
    "audience": [
      "student",
      "teacher"
    ],
    "in_scope": [
      "calculations with the working shown",
      "short factual answers",
      "unit conversions"
    ],
    "out_of_scope": [
      "long explanations (use nexa-tutor)",
      "completing assessed work",
      "claiming an answer comes from the PNG curriculum"
    ]
  },
  "capabilities": [
    "calculation",
    "chat"
  ],
  "interface": {
    "input": "nexa.run.request/1",
    "output": "nexa.run.response/1",
    "accepts_course_context": false,
    "max_input_messages": 50,
    "output_includes_citations": false
  },
  "permissions": {
    "run_permission": "model.invoke",
    "allowed_roles": [
      "student",
      "teacher",
      "school_admin",
      "ai_engineer",
      "admin",
      "platform_admin"
    ],
    "knowledge": {
      "access_classes": [],
      "scopes": []
    }
  },
  "tools": [],
  "model": {
    "model": "nexa-chat-precise",
    "fallbacks": [],
    "temperature": 0.1,
    "max_output_tokens": 600,
    "min_context_tokens": 4096
  },
  "memory": {
    "conversation": "request",
    "long_term": "none",
    "long_term_scopes": [],
    "retention_days": 0
  },
  "safety": {
    "policy": "nexa.safety.student/1",
    "serves_minors": true,
    "require_citations_for_curriculum": true,
    "general_answers": "labelled",
    "refuse": [
      "harmful or dangerous instructions",
      "adult or violent content",
      "self-harm",
      "completing assessed work",
      "political persuasion"
    ],
    "pii_in_prompts": "forbidden",
    "escalation": "Ask your teacher."
  },
  "runtime": {
    "timeout_s": 90,
    "retry": {
      "max_attempts": 2,
      "backoff_s": 2.0,
      "retry_on": [
        "gateway_unavailable"
      ]
    },
    "max_concurrent_runs": 0
  },
  "health": {
    "requires": [
      "model_gateway"
    ]
  },
  "lifecycle": {
    "state": "review",
    "changelog": [
      {
        "version": "1.1.0",
        "date": "2026-11-24",
        "change": "NEXA-M4-001: runs under the NEXA Teaching Intelligence Policy 1.0.0 (profile concise); the system prompt keeps only the agent's identity and task, the teaching rules come from the policy."
      },
      {
        "version": "1.0.0",
        "date": "2026-11-18",
        "change": "First manifest under nexa.agent/1.0; same prompt and model as the M1 agent 0.1.0."
      },
      {
        "version": "0.1.0",
        "date": "2026-10-30",
        "change": "M1 agent defined in code."
      }
    ]
  },
  "prompt": {
    "system": "You are NEXA in precise mode, for secondary school students and teachers in Papua New Guinea. Your task: give short, exact answers and worked calculations, showing the working for any calculation."
  },
  "pedagogy": {
    "policy": "nexa-teaching-policy",
    "version": "1.0.0",
    "profile": "concise"
  }
}
