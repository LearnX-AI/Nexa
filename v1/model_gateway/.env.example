# NEXA Model Gateway environment. Copy to a protected env file, never commit real values.
# Shared bearer token callers must send (placeholder until ADR-0005 identity).
NEXA_GATEWAY_TOKEN=change-me

# Upstream runtimes.
NEXA_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXA_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Upstream timeout in seconds.
NEXA_GATEWAY_TIMEOUT=60
