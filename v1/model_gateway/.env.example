# NEXA Model Gateway environment. Copy to a protected env file, never commit real values.
# Shared bearer token callers must send (placeholder until ADR-0005 identity).
NEXA_GATEWAY_TOKEN=change-me

# Upstream runtimes.
NEXA_OLLAMA_BASE_URL=http://127.0.0.1:11434
NEXA_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# vLLM and NVIDIA NIM (OpenAI-compatible). Keys are optional for self-hosted servers.
NEXA_VLLM_BASE_URL=http://127.0.0.1:8200/v1
NEXA_VLLM_API_KEY=
NEXA_NIM_BASE_URL=http://127.0.0.1:8300/v1
NEXA_NIM_API_KEY=

# Optional model registry file (see models.example.json). Unset = built-in defaults.
# NEXA_MODEL_CONFIG=/etc/nexa/models.json

# Upstream timeout in seconds, retry and circuit-breaker policy.
NEXA_GATEWAY_TIMEOUT=60
NEXA_GATEWAY_RETRY_ATTEMPTS=2
NEXA_GATEWAY_RETRY_BACKOFF=0.5
NEXA_GATEWAY_BREAKER_THRESHOLD=5
NEXA_GATEWAY_BREAKER_RESET=30
