{
  "tool_version": "nexa.tool/1.0",
  "id": "curriculum_map",
  "name": "Curriculum mapping",
  "version": "1.0.0",
  "owner": "NEXA AI engineering (Yasaru)",
  "description": "Maps a question or a piece of teaching content to the curriculum (NEXA-M4-004): grade, subject, unit, topic and official learning outcomes, with the sources and a confidence, as the calling user. Never maps to another grade than the one given or named in the text; outcomes come only from the official syllabus; says not_covered or ambiguous instead of guessing. grade and subject may be 'any'.",
  "state": "active",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "text"
    ],
    "properties": {
      "text": {
        "type": "string",
        "minLength": 3,
        "maxLength": 4000
      },
      "grade": {
        "type": "string",
        "pattern": "^(|any|[7-9]|1[0-2])$"
      },
      "subject": {
        "type": "string",
        "maxLength": 60
      }
    }
  },
  "permission": "knowledge.query",
  "scopes": {
    "curriculum.learner": {
      "description": "Learner material: syllabi, student guides, school and LMS content.",
      "roles": [
        "student",
        "teacher",
        "school_admin",
        "ai_engineer",
        "admin",
        "platform_admin"
      ]
    },
    "curriculum.teacher": {
      "description": "Teacher-only material: teacher guides, marking guides.",
      "roles": [
        "teacher",
        "school_admin",
        "ai_engineer",
        "admin",
        "platform_admin"
      ]
    }
  },
  "default_scopes": [
    "curriculum.learner"
  ],
  "allowed_agents": {
    "nexa-assessment-feedback": [
      "curriculum.learner",
      "curriculum.teacher"
    ],
    "nexa-curriculum-intelligence": [
      "curriculum.learner",
      "curriculum.teacher"
    ]
  },
  "timeout_s": 60,
  "rate_limit": {
    "per_user_per_minute": 30,
    "per_tool_per_minute": 600
  },
  "max_output_bytes": 65536,
  "side_effects": "read",
  "data": {
    "returns": "learner",
    "leaves_nexa": false
  },
  "implementation": {
    "kind": "http",
    "connector": "nexa-knowledge",
    "handler": "curriculum_map",
    "path": "/v1/knowledge/query"
  }
}
