NEXA_GATEWAY_URL=http://127.0.0.1:8100
NEXA_KNOWLEDGE_GATEWAY_TOKEN=
NEXA_EMBED_MODEL=nexa-embed-default
NEXA_KNOWLEDGE_STORE=memory
NEXA_KNOWLEDGE_TOP_K=5
NEXA_KNOWLEDGE_HOST=127.0.0.1
NEXA_KNOWLEDGE_PORT=8103
# NEXA_IDENTITY_SECRET is shared and loaded from /etc/nexa/identity.env
# ---- M2 ingestion ----
NEXA_KNOWLEDGE_REGISTRY=sqlite:////var/lib/nexa/knowledge/registry.db
NEXA_KNOWLEDGE_BLOB_DIR=/var/lib/nexa/knowledge/originals
NEXA_KNOWLEDGE_MAX_FILE_MB=60
NEXA_KNOWLEDGE_AV=clamav
NEXA_KNOWLEDGE_REQUIRE_AV=false
NEXA_KNOWLEDGE_OCR=true
NEXA_KNOWLEDGE_OCR_LANG=eng
NEXA_KNOWLEDGE_OCR_DPI=300
NEXA_KNOWLEDGE_OCR_LOW_CONF=70
# auto: allowed only on Pillow 13+ (Python 3.11+); off; force
NEXA_KNOWLEDGE_IMAGE_UPLOADS=auto
# Re-embed approved sources at startup (needed with the in-memory store)
NEXA_KNOWLEDGE_REINDEX_ON_START=true
