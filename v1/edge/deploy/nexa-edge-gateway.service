[Unit]
Description=NEXA school edge: Model Gateway (local Ollama models)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=nvidia
WorkingDirectory=/opt/nexa-edge/app
EnvironmentFile=/etc/nexa-edge/edge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/nexa-edge/venv/bin/python -m uvicorn v1.model_gateway.main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
